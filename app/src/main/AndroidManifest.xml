<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Tile peta OpenStreetMap dan geocoding Photon -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Status daring/luring di Profil -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lokasi laporan dan posisi pengguna di peta -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".CleanesiaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cleanesia">
        <activity
            android:name=".feature.landing.LandingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".feature.main.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.report.photo.ReportPhotoActivity"
            android:exported="false" />
        <activity
            android:name=".feature.report.detail.ReportDetailActivity"
            android:exported="false" />
        <activity
            android:name=".feature.report.done.ReportDoneActivity"
            android:exported="false" />
        <activity
            android:name=".feature.about.TentangActivity"
            android:exported="false" />

        <!-- Memberi aplikasi kamera akses tulis sementara ke file foto laporan di filesDir/foto. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>