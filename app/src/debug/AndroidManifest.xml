<?xml version="1.0" encoding="utf-8"?>
<!-- Hanya digabung ke build debug. Build release tidak memuat receiver ini. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- exported agar bisa dipicu dari adb shell tanpa root. -->
        <receiver
            android:name=".debug.DebugSeedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cleanesia.debug.SEED" />
                <action android:name="com.cleanesia.debug.CLEAR" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
